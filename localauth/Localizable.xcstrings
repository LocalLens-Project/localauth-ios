    "新令牌": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Token"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuevo token"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいトークン"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "新令牌"
          }
        }
      }
    },
    "旅行、过关或紧急清空前，你可以先上传一份临时旅行寄存密文，再清空本机令牌。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before travel, border inspection, or an emergency wipe, you can upload a temporary Travel Vault ciphertext and then clear local tokens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de viajar, pasar una inspección fronteriza o hacer un borrado de emergencia, puedes subir un cifrado temporal del resguardo de viaje y luego limpiar los tokens locales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行や出入国検査、緊急消去の前に、一時的な旅行寄存暗号文をアップロードしてから端末内トークンを消去できます。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行、過關或緊急清空前，你可以先上傳一份臨時旅行寄存密文，再清空本機令牌。"
          }
        }
      }
    },
    "旅行寄存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel Vault"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resguardo de viaje"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行保管庫"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存"
          }
        }
      }
    },
    "旅行寄存密文全程端到端加密，服务器无法读取令牌内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel Vault ciphertext stays end-to-end encrypted throughout, and the server cannot read token contents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cifrado del resguardo de viaje permanece cifrado de extremo a extremo en todo momento y el servidor no puede leer el contenido de los tokens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存の暗号文は全工程でエンドツーエンド暗号化され、サーバーはトークン内容を読み取れません。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存密文全程端對端加密，伺服器無法讀取令牌內容。"
          }
        }
      }
    },
    "旅行寄存已创建": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel vault created"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resguardo de viaje creado"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行保管庫を作成しました"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存已建立"
          }
        }
      }
    },
    "开源仓库默认不附带线上 Travel Vault 服务；如需使用，请先自行部署并完成配置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This open-source snapshot does not ship with a hosted Travel Vault service. Deploy and configure your own endpoint before using it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instantanea de codigo abierto no incluye un servicio Travel Vault alojado. Despliega y configura tu propio endpoint antes de usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオープンソース版にはホスト済みの Travel Vault サービスは含まれていません。使用する前に、自分のエンドポイントをデプロイして設定してください。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這份開源快照預設不附帶線上 Travel Vault 服務；如需使用，請先自行部署並完成設定。"
          }
        }
      }
    },
    "旅行寄存数据包过大，服务器已拒绝上传。请减少令牌数量后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The travel-vault package is too large and the server refused the upload. Reduce the number of tokens and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete del resguardo de viaje es demasiado grande y el servidor rechazó la carga. Reduce el número de tokens y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存パッケージが大きすぎるため、サーバーがアップロードを拒否しました。トークン数を減らしてから再試行してください。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存資料包過大，伺服器已拒絕上傳。請減少令牌數量後再試。"
          }
        }
      }
    },
    "旅行寄存数据损坏或格式无效，无法继续恢复。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The travel-vault data is corrupted or invalid, and the restore cannot continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos del resguardo de viaje están dañados o tienen un formato no válido; no se puede continuar con la restauración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行保管庫のデータが破損しているか無効な形式のため、復元を続行できません。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存資料已損壞或格式無效，無法繼續恢復。"
          }
        }
      }
    },
    "旅行寄存是低频紧急功能，当前操作过于频繁，请稍后再试。同一安装实例的新备份也会覆盖旧的未过期备份。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel Vault is a low-frequency emergency feature, and this action is happening too often. Please try again later. A new backup from the same installation also replaces the previous unexpired one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resguardo de viaje es una función de emergencia de uso poco frecuente, y esta operación se está realizando con demasiada frecuencia. Inténtalo de nuevo más tarde. Una nueva copia de seguridad desde la misma instalación también sustituirá a la anterior que aún no haya caducado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存は低頻度の緊急機能です。この操作は短時間に行われすぎています。しばらくしてからもう一度お試しください。同じインストール環境から新しく作成したバックアップは、有効期限内の以前のものも置き換えます。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存是低頻緊急功能，目前操作過於頻繁，請稍後再試。同一安裝實例的新備份也會覆蓋先前尚未過期的備份。"
          }
        }
      }
    },
    "旅行寄存服务器的安全连接失败，请检查网络环境或稍后重试。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A secure connection to the travel-vault server failed. Please check the network environment or try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la conexión segura con el servidor del resguardo de viaje. Revisa la red o inténtalo de nuevo más tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行保管庫サーバーへの安全な接続に失敗しました。ネットワーク環境を確認するか、しばらくしてから再試行してください。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行寄存伺服器的安全連線失敗，請檢查網路環境或稍後重試。"
          }
        }
      }
    },
    "旅行寄存条目缺少可恢复明文副本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This travel-vault entry is missing its recoverable plaintext copy."
