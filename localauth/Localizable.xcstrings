    "收到无法识别的同步消息，已中止本次同步。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unrecognized sync message was received. This sync has been aborted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recibió un mensaje de sincronización no reconocido. Esta sincronización se ha cancelado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "識別できない同期メッセージを受信したため、今回の同期を中止しました。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
