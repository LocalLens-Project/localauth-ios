          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "手機靠近支援 CTAP2 hmac-secret 的硬體密鑰，透過 NFC 完成識別與通訊。"
          }
        }
      }
    },
