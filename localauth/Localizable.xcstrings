          }
        }
      }
    },
    "Travel Vault 的设备证明失败。请检查 App Attest 配置、Bundle Identifier 与远端验证服务。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel Vault device attestation failed. Check your App Attest setup, bundle identifier, and remote verifier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La atestacion del dispositivo para Travel Vault fallo. Revisa la configuracion de App Attest, el identificador del paquete y el verificador remoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel Vault のデバイス証明に失敗しました。App Attest の設定、Bundle Identifier、リモート検証サービスを確認してください。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel Vault 的裝置證明失敗。請檢查 App Attest 設定、Bundle Identifier 與遠端驗證服務。"
          }
        }
      }
    },
