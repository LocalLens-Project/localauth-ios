            "state": "translated",
            "value": "A esta entrada del resguardo de viaje le falta su copia recuperable en texto claro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この旅行寄存エントリには復元可能な平文コピーがありません。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "這個旅行寄存項目缺少可恢復的明文副本。"
          }
        }
      }
    },
    "旅行寄存条目缺少必要的密文元数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This travel-vault entry is missing required ciphertext metadata."
          }
        },
        "es": {
