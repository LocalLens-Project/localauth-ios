          }
        }
      }
    },
    "当前旅行寄存条目不是密文壳恢复格式。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This travel-vault entry is not in ciphertext-shell restore format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entrada del resguardo de viaje no está en formato de restauración por encapsulado cifrado."
          }
        },
        "ja": {
