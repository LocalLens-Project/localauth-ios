    "该令牌使用了当前不支持的算法。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This token uses an algorithm that is not currently supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
