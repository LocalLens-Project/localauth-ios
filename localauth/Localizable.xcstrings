    },
    "YubiKey 未能完成挑战响应，请确认已配置 Slot 2 的 HMAC-SHA1 challenge-response。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey failed to complete the challenge-response. Please confirm that HMAC-SHA1 challenge-response is configured in Slot 2."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey no pudo completar la respuesta al desafío. Confirme que HMAC-SHA1 challenge-response esté configurado en el Slot 2."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKeyがチャレンジレスポンスを完了できませんでした。スロット2にHMAC-SHA1チャレンジレスポンスが設定されていることを確認してください。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "YubiKey 未能完成挑戰回應，請確認已配置 Slot 2 的 HMAC-SHA1 challenge-response。"
          }
        }
      }
    },
