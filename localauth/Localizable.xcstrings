      }
    },
    "当前硬件密钥不支持已实现的 pinUvAuth 协议版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current hardware key does not support the implemented pinUvAuth protocol version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llave de hardware actual no es compatible con la versión implementada del protocolo pinUvAuth."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のハードウェアキーは実装済みの pinUvAuth プロトコルバージョンに対応していません。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "目前硬體密鑰不支援已實作的 pinUvAuth 協議版本。"
          }
        }
      }
    },
    "当前硬件密钥不支持标准 hmac-secret 流程，请确认它支持 CTAP2 与 hmac-secret 扩展。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current hardware key does not support the standard hmac-secret flow. Please make sure it supports CTAP2 and the hmac-secret extension."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de hardware actual no admite el flujo estándar de hmac-secret. Asegúrese de que admita CTAP2 y la extensión hmac-secret."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のハードウェアキーは標準のhmac-secretフローをサポートしていません。CTAP2およびhmac-secret拡張をサポートしているか確認してください。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "目前硬體金鑰不支援標準 hmac-secret 流程，請確認它支援 CTAP2 與 hmac-secret 擴充。"
          }
        }
      }
    },
    "当前硬件密钥未声明 hmac-secret 扩展支持。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current hardware key does not advertise hmac-secret extension support."
          }
        },
        "es": {
