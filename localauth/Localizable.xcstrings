    "手机靠近 Yubikey 完成挑战响应，提升高级防护强度。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone near the YubiKey to complete challenge-response for stronger advanced protection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerque su teléfono al YubiKey para completar el challenge-response y reforzar la protección avanzada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンをYubiKeyに近づけてチャレンジレスポンスを完了し、上位保護強度を高めます。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "手機靠近 YubiKey 完成挑戰回應，提升高級防護強度。"
          }
        }
      }
    },
    "手机靠近支持 CTAP2 hmac-secret 的硬件密钥，通过 NFC 完成识别与通信。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your phone near a CTAP2 hmac-secret compatible hardware key and use NFC for detection and communication."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerque el teléfono a una llave de hardware compatible con CTAP2 hmac-secret y use NFC para la detección y la comunicación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
