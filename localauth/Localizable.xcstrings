    "Yubico 提供的 iOS SDK，用于通过 NFC 与 YubiKey 进行安全交互。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An iOS SDK provided by Yubico for secure interaction with YubiKey over NFC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un SDK de iOS proporcionado por Yubico para interactuar de forma segura con YubiKey mediante NFC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yubico が提供する iOS SDK で、NFC を通じて YubiKey と安全に連携するために使用します。"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Yubico 提供的 iOS SDK，用於透過 NFC 與 YubiKey 進行安全互動。"
          }
        }
      }
    },
    "YubiKey 专属通道": {
