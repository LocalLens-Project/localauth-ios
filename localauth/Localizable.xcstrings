    "1、点击 Application": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Click Application"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Haga clic en Application"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Application をクリック"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "1、點擊 Application"
          }
        }
      }
    },
    "2、在展开列表中选择 OTP": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Select OTP in the expanded list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Seleccione OTP en la lista desplegada"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 展開リストから OTP を選択"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "2、在展開列表中選擇 OTP"
          }
        }
      }
    },
    "3、若有原有配置，先点击 Delete，再点击 Long Touch (Slot 2) 下的 Configure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. If there is an existing config, click Delete, then Configure under Long Touch (Slot 2)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Si existe una configuración previa, pulse Delete y luego Configure en Long Touch (Slot 2)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 既存設定がある場合は Delete を押し、その後 Long Touch（Slot 2）の Configure を押します"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "3、若有原有配置，先點擊 Delete，再點擊 Long Touch（Slot 2）下的 Configure"
          }
        }
      }
    },
    "4、默认选中的是 Yubico OTP，请勾选 Challenge-response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Yubico OTP is selected by default, choose Challenge-response"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Yubico OTP está seleccionado por defecto; marque Challenge-response"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 初期選択は Yubico OTP です。Challenge-response を選択してください"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "4、預設選中的是 Yubico OTP，請勾選 Challenge-response"
          }
        }
      }
    },
    "5、点击右侧 Generate 生成 Secret key，随后可拔出 YubiKey": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Click Generate on the right to create the Secret key, then unplug your YubiKey"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Pulse Generate a la derecha para crear la Secret key; después puede retirar su YubiKey"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 右側の Generate で Secret key を作成し、その後 YubiKey を取り外します"
          }
        },
        "zh-Hant-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "5、點擊右側 Generate 生成 Secret key，之後可拔出 YubiKey"
          }
        }
      }
    },
