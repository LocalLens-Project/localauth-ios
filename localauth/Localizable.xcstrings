    "使用 Face ID / Touch ID 快速验证，日常使用更便捷。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID / Touch ID for fast verification and easier daily use."
          }
        },
        "es": {
